FIREBASE_WEB_API_KEY=
# No computador: o NOME do arquivo da chave do Firebase, na pasta do projeto.
FIREBASE_SERVICE_ACCOUNT=seu-arquivo-adminsdk.json
# Online (Render): em vez do nome, o CONTEÚDO inteiro desse arquivo (o JSON),
# porque o arquivo da chave não vai para o GitHub. Use uma ou outra.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# E-mail dos códigos de verificação (cadastro e "Esqueceu sua senha?").
# Sem isto, o código aparece só no terminal do servidor.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=seu@gmail.com e
# SMTP_PASS=uma "senha de app" (precisa da verificação em duas etapas ligada).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE=Mercado Local <seu@gmail.com>
